<local:GlassPanel x:Class="Kedip.DockBar.AppsPanelWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:Kedip.DockBar"
                  Title="Semua app">
    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource DockEdge}" BorderThickness="1" CornerRadius="20"
            Padding="16,14,16,12">
        <StackPanel Width="584">
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Height="40" Tag="Cari app…" />
            <TextBlock x:Name="SectionTitle" Text="Semua app" Margin="4,14,0,6" FontSize="13" FontWeight="SemiBold" Opacity="0.85" />
            <Grid Height="392">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <WrapPanel x:Name="AppGrid" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="Nggak ada app yang cocok." Visibility="Collapsed" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
            <Border Height="1" Margin="0,8,0,8" Background="{StaticResource DockLine}" />
            <Grid>
                <Button x:Name="WindowsStartButton" Style="{StaticResource DockButton}" Height="36" Padding="10,0" HorizontalAlignment="Left"
                        ToolTip="Buka Start menu Windows">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE8A9;" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="13" Text="Start Windows" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Style="{StaticResource RoundIconButton}" Content="&#xE713;" ToolTip="Pengaturan Windows" />
                    <Button x:Name="PowerButton" Style="{StaticResource RoundIconButton}" Content="&#xE7E8;" ToolTip="Kunci, tidur, mulai ulang, matikan" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</local:GlassPanel>
