<Window x:Class="Kedip.DockBar.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kedip Dock"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource DockTextBrush}"
        TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kedip;component/Dock/DockTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- One glass capsule with fully rounded ends; Start sits in the left end. The window is cut to it (see ApplyShape). -->
    <Border x:Name="Bar" Style="{StaticResource DockSegment}" Padding="4,0,10,0">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="StartButton" AutomationProperties.Name="Start" Style="{StaticResource DockCircleButton}"
                    ToolTip="Start (klik kanan: menu cepat)">
                <Grid Width="18" Height="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border Margin="1" CornerRadius="3" Background="{DynamicResource DockAccentBrush}" />
                    <Border Grid.Column="1" Margin="1" CornerRadius="3" Background="{DynamicResource DockAccentBrush}" />
                    <Border Grid.Row="1" Margin="1" CornerRadius="3" Background="{DynamicResource DockAccentBrush}" />
                    <Border Grid.Row="1" Grid.Column="1" Margin="1" CornerRadius="3" Background="{DynamicResource DockAccentBrush}" />
                </Grid>
            </Button>

            <Rectangle Style="{StaticResource DockDivider}" Margin="5,0,7,0" />
            <StackPanel x:Name="PinnedPanel" Orientation="Horizontal" />
            <Rectangle x:Name="RunningDivider" Style="{StaticResource DockDivider}" />
            <StackPanel x:Name="RunningPanel" Orientation="Horizontal" />
            <Rectangle Style="{StaticResource DockDivider}" />

                <Button x:Name="TrayButton" AutomationProperties.Name="Ikon tersembunyi" Style="{StaticResource DockButton}" MinWidth="30"
                        Padding="4,0" ToolTip="Tampilkan ikon tersembunyi">
                    <TextBlock x:Name="TrayGlyph" Style="{StaticResource DockGlyph}" FontSize="12" />
                </Button>

                <!-- Network, volume and battery share one hover plate (like the Windows tray); scroll to change the volume. -->
                <Button x:Name="StatusButton" AutomationProperties.Name="Status" Style="{StaticResource DockButton}" Padding="7,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Signal bars drawn over a faint full fan, as Windows draws them. -->
                        <Border x:Name="NetworkCell" Style="{StaticResource StatusCell}">
                            <Grid Width="20">
                                <TextBlock x:Name="NetworkBase" Style="{StaticResource DockGlyph}" Opacity="0.3" />
                                <TextBlock x:Name="NetworkGlyph" Style="{StaticResource DockGlyph}" />
                            </Grid>
                        </Border>
                        <Border x:Name="VolumeCell" Style="{StaticResource StatusCell}">
                            <TextBlock x:Name="VolumeGlyph" Style="{StaticResource DockGlyph}" />
                        </Border>
                        <Border x:Name="BatteryCell" Style="{StaticResource StatusCell}" Padding="4,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BatteryGlyph" Style="{StaticResource DockGlyph}" FontSize="17" />
                                <TextBlock x:Name="BatteryPercent" Margin="5,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="NetSpeedPanel" VerticalAlignment="Center" Margin="8,0,6,0">
                    <TextBlock x:Name="DownText" FontSize="10.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="UpText" FontSize="10.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource DockText2Brush}" />
                </StackPanel>

                <StackPanel x:Name="WeatherPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <TextBlock x:Name="WeatherGlyph" FontFamily="Segoe UI Symbol" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock x:Name="WeatherText" Margin="5,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>

                <Button x:Name="ClockButton" AutomationProperties.Name="Jam" Style="{StaticResource DockButton}" Padding="10,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Only while Do Not Disturb is on. -->
                        <TextBlock x:Name="DndBadge" Style="{StaticResource DockGlyph}" FontSize="13" Margin="0,0,9,0"
                                   Foreground="{DynamicResource DockAccentBrush}" Visibility="Collapsed" />
                        <StackPanel>
                            <TextBlock x:Name="ClockText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="DateText" Style="{StaticResource DockCaption}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="DesktopButton" AutomationProperties.Name="Desktop" Style="{StaticResource DockButton}" MinWidth="36" ToolTip="Tampilkan desktop">
                    <Border Width="16" Height="12" BorderBrush="{DynamicResource DockTextBrush}" BorderThickness="1.5" CornerRadius="3" Opacity="0.85" />
                </Button>
        </StackPanel>
    </Border>
</Window>
