<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared look of the dock and its panels: black smoked glass over the system blur, hairline edges, accent from Windows. -->
        <LinearGradientBrush x:Key="DockSurface" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#8C0F0F12" />
            <GradientStop Offset="1" Color="#AC060607" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelSurface" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#A80E0E11" />
            <GradientStop Offset="1" Color="#C4060607" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DockSheen" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#00FFFFFF" />
            <GradientStop Offset="0.5" Color="#38FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
        </LinearGradientBrush>
        <!-- Glass edge: brighter along the top, fading down. -->
        <LinearGradientBrush x:Key="DockEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#40FFFFFF" />
            <GradientStop Offset="0.45" Color="#14FFFFFF" />
            <GradientStop Offset="1" Color="#1CFFFFFF" />
        </LinearGradientBrush>
        <!-- App tiles: one glass tile per logo so the row looks even. -->
        <LinearGradientBrush x:Key="AppTileFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#2EFFFFFF" />
            <GradientStop Offset="1" Color="#0FFFFFFF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AppTileActiveFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#4AFFFFFF" />
            <GradientStop Offset="1" Color="#1FFFFFFF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AppTileEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#4DFFFFFF" />
            <GradientStop Offset="1" Color="#0AFFFFFF" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DockHover" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="DockPress" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="DockLine" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="DockMenu" Color="#F20D0D0F" />
        <SolidColorBrush x:Key="DockMenuEdge" Color="#24FFFFFF" />
        <!-- Replaced per window with the Windows accent (see DockAccent). -->
        <SolidColorBrush x:Key="DockAccentBrush" Color="#FF4CC2FF" />
        <SolidColorBrush x:Key="DockAccentHoverBrush" Color="#E64CC2FF" />
        <SolidColorBrush x:Key="DockOnAccentBrush" Color="#E6000000" />

        <!-- The dock body: a glass capsule with fully rounded ends. -->
        <Style x:Key="DockSegment" TargetType="Border">
            <Setter Property="Height" Value="60" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Background" Value="{StaticResource DockSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource DockEdge}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Round Start button, sitting in the capsule's left end. -->
        <Style x:Key="DockCircleButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Plate" Fill="Transparent" />
                            <ContentPresenter x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource DockHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource DockPress}" />
                                <Setter TargetName="Body" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button without chrome (app tiles draw their own). -->
        <Style x:Key="DockPlainButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One cell of the status group (network / volume / battery): hit area for its own tooltip. -->
        <Style x:Key="StatusCell" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="3,0" />
        </Style>

        <!-- Icon/tile button: rounded hover plate, slight press dip. -->
        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Plate" CornerRadius="17" Background="Transparent" Margin="0,3" />
                            <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockPress}" />
                                <Setter TargetName="Body" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.93" ScaleY="0.93" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DockCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="DockDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="7,0" />
            <Setter Property="Fill" Value="{StaticResource DockLine}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Dark rounded context menu. -->
        <Style TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource DockMenu}" BorderBrush="{StaticResource DockMenuEdge}" BorderThickness="1" CornerRadius="16"
                                Padding="6" MinWidth="190" Margin="0,0,0,6">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" CornerRadius="10" Padding="10,7" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" VerticalAlignment="Center" Opacity="0.85" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource DockHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{StaticResource DockLine}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource DockMenu}" BorderBrush="{StaticResource DockMenuEdge}" BorderThickness="1" CornerRadius="11" Padding="10,5"
                                Margin="0,0,0,8">
                            <ContentPresenter TextBlock.FontSize="12" TextBlock.FontFamily="{StaticResource UiFont}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    <SolidColorBrush x:Key="PanelCard" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PanelCardEdge" Color="#10FFFFFF" />

    <!-- Half of a quick-settings tile (the toggle, or the chevron that opens its page); Tag = CornerRadius. -->
    <Style x:Key="TilePart" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Hit" Background="Transparent"
                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hit" Property="Background" Value="#16FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hit" Property="Background" Value="#0AFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round icon button (panel headers, slider ends). -->
    <Style x:Key="RoundIconButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" CornerRadius="17" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockPress}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: thin track filled with the accent up to a ringed thumb (as in Windows). -->
    <Style x:Key="PanelSliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PanelSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PanelSliderFill}" Background="{DynamicResource DockAccentBrush}"
                                              Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PanelSliderFill}" Background="#4DFFFFFF" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="20" Height="20" Background="Transparent">
                                                <Ellipse Fill="#FF3A3A3D" Stroke="#26FFFFFF" StrokeThickness="1" />
                                                <Ellipse x:Name="Core" Width="10" Height="10" Fill="{DynamicResource DockAccentBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Core" Property="Width" Value="12" />
                                                    <Setter TargetName="Core" Property="Height" Value="12" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Core" Property="Width" Value="8" />
                                                    <Setter TargetName="Core" Property="Height" Value="8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off switch for page headers. -->
    <Style x:Key="PanelSwitch" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="40" Height="20" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1" BorderBrush="#B3FFFFFF" Background="#0FFFFFFF" />
                        <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="#D9FFFFFF" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource DockAccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource DockAccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource DockOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                            <Setter TargetName="Knob" Property="Margin" Value="3,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in a page list (network, device): content is built in code; Tag="on" marks the selected one. -->
    <Style x:Key="PanelRow" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" CornerRadius="12" Background="Transparent" Padding="10,8">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#12FFFFFF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="Plate" Property="Background" Value="#17FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text button for page footers ("Pengaturan ... lainnya"). -->
    <Style x:Key="PanelLink" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" CornerRadius="12" Background="Transparent" Padding="10,8">
                        <ContentPresenter HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockPress}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filled action button ("Hubungkan"); PanelButton is the quiet one ("Putuskan"). -->
    <Style x:Key="PanelAccentButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource DockOnAccentBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" CornerRadius="15" Background="{DynamicResource DockAccentBrush}" Padding="16,6">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource DockAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Plate" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PanelButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" CornerRadius="15" Background="#1CFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="16,5">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#28FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Plate" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small check box ("Hubungkan otomatis"). -->
    <Style x:Key="PanelCheck" TargetType="CheckBox">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1" BorderBrush="#B3FFFFFF"
                                Background="Transparent">
                            <TextBlock x:Name="Tick" FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE73E;"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DockOnAccentBrush}"
                                       Visibility="Hidden" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DockAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DockAccentBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Password field for joining a network. -->
    <Style x:Key="PanelPassword" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DockAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Box" CornerRadius="16" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="12,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DockAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An icon in the tray flyout. -->
    <Style x:Key="TrayCell" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" CornerRadius="13" Background="Transparent" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockPress}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search box with a placeholder (Tag). -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DockAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" CornerRadius="20" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE721;" VerticalAlignment="Center"
                                       Opacity="0.7" Margin="0,0,10,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DockAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- App cell in the all-apps grid. -->
    <Style x:Key="AppCell" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="92" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" CornerRadius="18" Background="Transparent" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockPress}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scrollbar for panels. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="#40FFFFFF" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
