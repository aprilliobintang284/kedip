<local:GlassPanel x:Class="Kedip.DockBar.ControlPanelWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:Kedip.DockBar"
                  Title="Kontrol cepat">
    <Border Background="{StaticResource PanelSurface}">
        <Grid Width="372" ClipToBounds="True">
            <!-- Main page: tiles (split ones open a page with their chevron), sliders, battery footer. -->
            <StackPanel x:Name="MainPage">
                <StackPanel Margin="16,16,16,0">
                    <WrapPanel x:Name="Tiles" Margin="-5,0" />

                    <Grid x:Name="VolumeRow" Margin="0,12,0,0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MuteButton" Style="{StaticResource RoundIconButton}" Content="&#xE995;" ToolTip="Bisukan" />
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource PanelSlider}" Margin="6,0" />
                        <TextBlock x:Name="VolumeValue" Grid.Column="2" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                        <Button x:Name="OutputButton" Grid.Column="3" Style="{StaticResource RoundIconButton}" Margin="4,0,-6,0"
                                ToolTip="Pilih perangkat suara" AutomationProperties.Name="Output suara">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE9E9;" VerticalAlignment="Center" />
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="9" Text="&#xE76C;" Margin="3,1,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid x:Name="BrightnessRow" Margin="0,2,0,0" Visibility="Collapsed" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" Text="&#xE706;" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource PanelSlider}" Margin="6,0" />
                        <TextBlock x:Name="BrightnessValue" Grid.Column="2" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                        <Border Grid.Column="3" Width="34" Margin="4,0,-6,0" />
                    </Grid>
                </StackPanel>

                <Border Margin="0,14,0,0" Padding="12,6" Background="#0AFFFFFF" BorderBrush="{StaticResource DockLine}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Button x:Name="BatteryButton" Style="{StaticResource PanelLink}" HorizontalAlignment="Left" ToolTip="Pengaturan baterai">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BatteryGlyph" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock x:Name="BatteryText" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="KedipSettingsButton" Style="{StaticResource RoundIconButton}" Content="&#xE7B3;"
                                    ToolTip="Pengaturan Kedip" />
                            <Button x:Name="SettingsButton" Style="{StaticResource RoundIconButton}" Content="&#xE713;"
                                    ToolTip="Pengaturan Windows" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Detail page (Wi-Fi networks, Bluetooth devices, sound output), filled in code. -->
            <DockPanel x:Name="DetailPage" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="10,12,16,8">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="DetailBack" Style="{StaticResource RoundIconButton}" Content="&#xE72B;" FontSize="13"
                                ToolTip="Kembali" AutomationProperties.Name="Kembali" />
                        <TextBlock x:Name="DetailTitle" Margin="6,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ToggleButton x:Name="DetailSwitch" Style="{StaticResource PanelSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,4" Background="#0AFFFFFF" BorderBrush="{StaticResource DockLine}"
                        BorderThickness="0,1,0,0">
                    <Button x:Name="DetailMore" Style="{StaticResource PanelLink}" />
                </Border>
                <StackPanel>
                    <TextBlock x:Name="DetailStatus" Margin="18,0,18,6" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ScrollViewer x:Name="DetailScroll" MaxHeight="330" Margin="8,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailList" Margin="0,0,4,0" />
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</local:GlassPanel>
