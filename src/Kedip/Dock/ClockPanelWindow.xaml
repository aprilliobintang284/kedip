<local:GlassPanel x:Class="Kedip.DockBar.ClockPanelWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:Kedip.DockBar"
                  Title="Kalender">
    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource DockEdge}" BorderThickness="1" CornerRadius="20">
        <StackPanel Width="360">
            <!-- Notifications (what Windows' notification centre holds), grouped by app. -->
            <Grid Margin="18,14,12,8">
                <TextBlock Text="Notifikasi" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DndButton" Style="{StaticResource RoundIconButton}" AutomationProperties.Name="Do not disturb" />
                    <Button x:Name="ClearButton" Style="{StaticResource PanelButton}" MinWidth="0" Margin="6,0,0,0" VerticalAlignment="Center"
                            Content="Bersihkan" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="NotificationScroll" MaxHeight="300" Margin="10,0,6,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NotificationList" Margin="0,0,4,6" />
            </ScrollViewer>
            <StackPanel x:Name="EmptyNotifications" Margin="0,2,0,16" Visibility="Collapsed" HorizontalAlignment="Center">
                <TextBlock x:Name="EmptyGlyph" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center" Opacity="0.5" />
                <TextBlock x:Name="EmptyText" Margin="0,8,0,0" FontSize="12.5" HorizontalAlignment="Center"
                           Foreground="{StaticResource DockText2Brush}" Text="Tidak ada notifikasi baru" />
            </StackPanel>

            <Border Height="1" Background="{StaticResource DockLine}" />

            <!-- Date (with the Hijri date) and the month. -->
            <Grid Margin="18,12,12,2">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DateTitle" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="HijriText" Margin="0,2,0,0" FontSize="11.5" Foreground="{StaticResource DockText2Brush}" />
                </StackPanel>
                <Button x:Name="CollapseButton" Style="{StaticResource RoundIconButton}" HorizontalAlignment="Right" FontSize="11"
                        AutomationProperties.Name="Ciutkan kalender" />
            </Grid>
            <StackPanel x:Name="CalendarBody" Margin="12,4,12,8">
                <Grid Margin="8,0,0,4">
                    <TextBlock x:Name="MonthTitle" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TodayButton" Style="{StaticResource PanelLink}" HorizontalAlignment="Right" Content="Hari ini"
                                Visibility="Collapsed" />
                        <Button x:Name="PrevMonth" Style="{StaticResource RoundIconButton}" FontSize="11" AutomationProperties.Name="Bulan sebelumnya" />
                        <Button x:Name="NextMonth" Style="{StaticResource RoundIconButton}" FontSize="11" AutomationProperties.Name="Bulan berikutnya" />
                    </StackPanel>
                </Grid>
                <UniformGrid x:Name="DayNames" Columns="7" Margin="0,2,0,2" />
                <UniformGrid x:Name="DaysGrid" Columns="7" Rows="6" />
            </StackPanel>

            <!-- Focus timer (Kedip's pomodoro). -->
            <Border Padding="14,10" Background="{StaticResource Ink0A}" BorderBrush="{StaticResource DockLine}" BorderThickness="0,1,0,0" CornerRadius="0,0,19,19">
                <Grid>
                    <StackPanel x:Name="FocusSetup" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LessButton" Style="{StaticResource RoundIconButton}" FontSize="12" AutomationProperties.Name="Kurangi waktu fokus" />
                        <TextBlock x:Name="FocusMinutesText" Width="66" FontSize="13.5" FontWeight="SemiBold" TextAlignment="Center"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        <Button x:Name="MoreButton" Style="{StaticResource RoundIconButton}" FontSize="12" AutomationProperties.Name="Tambah waktu fokus" />
                    </StackPanel>
                    <StackPanel x:Name="FocusRunning" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="FocusPhaseText" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource DockText2Brush}" />
                        <TextBlock x:Name="FocusTimeText" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="StopButton" Style="{StaticResource PanelButton}" MinWidth="0" Content="Stop" Visibility="Collapsed" />
                        <Button x:Name="FocusButton" Style="{StaticResource PanelAccentButton}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</local:GlassPanel>
