<Application x:Class="Kedip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="NotchBrush" Color="#FF000000" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF34C759" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FFFF9F0A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A" />
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Application.Resources>
</Application>
