<UserControl x:Class="Kedip.Shell.Island.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:island="clr-namespace:Kedip.Shell.Island"
             Width="460" Height="190" Focusable="False" IsTabStop="False" SnapsToDevicePixels="True"
             Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0"
             FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimaryBrush}">
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="Zoom" />
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="VerticalOffset" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F2202022" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="6"
                                Padding="8,4" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
            <Setter Property="ToolTipService.ShowDuration" Value="3000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverFill" CornerRadius="13" Background="#14FFFFFF" Opacity="0" />
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top row: tabs on the left, a quiet status (time, battery) on the right. Empty area click = collapse. -->
        <Grid x:Name="TopRow" Background="Transparent" TextOptions.TextFormattingMode="Display"
              RenderOptions.ClearTypeHint="Enabled">
            <Canvas x:Name="TabTrack" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,6,0,0"
                    IsHitTestVisible="False">
                <Border x:Name="TabIndicator" Width="36" Height="26" CornerRadius="13" Background="#26FFFFFF"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="IndicatorShift" />
                    </Border.RenderTransform>
                </Border>
            </Canvas>
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="14,6,0,0" />

            <StackPanel x:Name="Status" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,18,0" Height="26" IsHitTestVisible="False">
                <TextBlock x:Name="ClockText" FontSize="12" FontWeight="SemiBold" Opacity="0.72"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                <StackPanel x:Name="BatteryStatus" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryText" FontSize="11.5" FontWeight="SemiBold" Opacity="0.72"
                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <island:BatteryGlyph x:Name="Battery" Width="22" Height="11" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Feature panels (440×150), created on first use and kept. -->
        <Grid x:Name="PanelHost" Grid.Row="1" Width="440" Height="150" HorizontalAlignment="Center" ClipToBounds="True" />

        <!-- Shown while files are dragged over the island. -->
        <Grid x:Name="DropHint" Grid.Row="1" Width="440" Height="150" HorizontalAlignment="Center"
              IsHitTestVisible="False" Opacity="0" Visibility="Collapsed"
              TextOptions.TextFormattingMode="Display">
            <Rectangle RadiusX="16" RadiusY="16" Fill="#E6000000" Stroke="#59FFFFFF" StrokeThickness="1.25"
                       StrokeDashArray="4 3" StrokeDashCap="Round" Margin="0.5" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="20" Background="#2934C759" HorizontalAlignment="Center">
                    <TextBlock x:Name="DropGlyph" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Lepas di sini buat simpan ke Shelf" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="File aslinya tetap di tempatnya, kok" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
