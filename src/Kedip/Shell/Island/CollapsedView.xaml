<UserControl x:Class="Kedip.Shell.Island.CollapsedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:island="clr-namespace:Kedip.Shell.Island"
             Focusable="False" IsTabStop="False" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">
    <!-- Single cell: centre content is centred on the whole island, wings hug the edges. -->
    <Grid x:Name="Root" ClipToBounds="False">

        <!-- Left wing: album art or charging bolt -->
        <Grid x:Name="ArtFrame" HorizontalAlignment="Left" VerticalAlignment="Center"
              Opacity="0" Visibility="Collapsed">
            <Border x:Name="ArtPlaceholder" Background="{StaticResource SurfaceBrush}">
                <TextBlock x:Name="ArtPlaceholderGlyph" FontFamily="{StaticResource IconFont}" Text="&#xEC4F;"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Image x:Name="ArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border x:Name="ArtRim" BorderBrush="#1FFFFFFF" BorderThickness="1" />
        </Grid>
        <!-- Hand-drawn filled bolt: reads better than the outline icon at this size. -->
        <Path x:Name="BoltGlyph" Data="M7.6,0 L0.6,10.3 L5.5,10.3 L4.2,18 L11.4,7.4 L6.5,7.4 Z"
              Fill="{StaticResource AccentBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="0.9"
              StrokeLineJoin="Round" Stretch="Uniform"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              Opacity="0" Visibility="Collapsed" />

        <!-- Centre: clock, eyes or the current lyric line -->
        <TextBlock x:Name="ClockText" FontFamily="{StaticResource UiFont}" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed" />
        <Border x:Name="EyesHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0" Visibility="Collapsed" />
        <TextBlock x:Name="LyricA" FontFamily="{StaticResource UiFont}" FontWeight="Medium"
                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed">
            <TextBlock.RenderTransform>
                <TranslateTransform />
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="LyricB" FontFamily="{StaticResource UiFont}" FontWeight="Medium"
                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed">
            <TextBlock.RenderTransform>
                <TranslateTransform />
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- Right wing: equalizer or battery percentage -->
        <island:EqualizerBars x:Name="Equalizer" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Opacity="0" Visibility="Collapsed" />
        <TextBlock x:Name="BatteryText" FontFamily="{StaticResource UiFont}" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}" Typography.NumeralAlignment="Tabular"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed" />
    </Grid>
</UserControl>
