<Window x:Class="Kedip.Shell.Settings.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tentang Kedip" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="/Kedip;component/Assets/kedip.ico"
        Background="{DynamicResource SWindowBrush}" Foreground="{DynamicResource STextBrush}"
        FontFamily="{DynamicResource SUiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kedip;component/Shell/Settings/SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel x:Name="Root" Margin="24,32,24,24">
        <StackPanel.RenderTransform>
            <TranslateTransform />
        </StackPanel.RenderTransform>

        <Image Width="96" Height="62" HorizontalAlignment="Center" Source="{StaticResource SLogoImage}" />
        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Text="Kedip" FontFamily="{StaticResource SDisplayFont}"
                   FontSize="26" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" />
        <TextBlock x:Name="VersionText" Margin="0,2,0,0" HorizontalAlignment="Center"
                   Foreground="{StaticResource STextSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20">
            <Run Text="Dibuat oleh Aprillio." /><LineBreak /><Run Foreground="{StaticResource STextSecondaryBrush}"
                Text="Notch ringan dengan maskot mata, musik &amp; lirik, waktu sholat, dan pengingat, tepat di atas layarmu." />
        </TextBlock>
        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource STextTertiaryBrush}"
                   Text="© 2026 Aprillio" />

        <Border Margin="0,24,0,24" Style="{StaticResource SCard}">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SLabel}" Text="Folder data" />
                    <TextBlock x:Name="DataPathText" Style="{StaticResource SHint}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SButton}" MinWidth="72" Click="OnOpenFolder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource SIconFont}" FontSize="14" Text="&#xE838;" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Buka" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Button HorizontalAlignment="Right" Style="{StaticResource SButton}" Content="Tutup" IsCancel="True" IsDefault="True"
                Click="OnClose" />
    </StackPanel>
</Window>
