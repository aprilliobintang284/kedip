<Window x:Class="Kedip.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:island="clr-namespace:Kedip.Shell.Island"
        Title="Kedip"
        Width="600" Height="260" Left="0" Top="0" WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">
    <!-- Only the island paints; every other pixel stays fully transparent and therefore click-through. -->
    <island:IslandSurface x:Name="Surface" Fill="{StaticResource NotchBrush}" AllowDrop="True" Focusable="False" />
</Window>
