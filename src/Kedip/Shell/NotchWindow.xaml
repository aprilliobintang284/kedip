<Window x:Class="Kedip.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kedip"
        Width="600" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <!-- OWNER: A. Scaffold stub: a plain black pill with the clock. -->
    <Border x:Name="Island" Width="166" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center"
            Background="{StaticResource NotchBrush}" CornerRadius="0,0,14,14">
        <TextBlock x:Name="ClockText" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
</Window>
