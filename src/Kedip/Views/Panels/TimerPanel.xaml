<UserControl x:Class="Kedip.Views.Panels.TimerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="440" d:DesignHeight="150"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource DockTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.ClearTypeHint="Enabled">
    <!-- Pomodoro (left card) + water intake (right card). Area: 440x150 DIP on black. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kedip;component/Productivity/PanelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BigNumber" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DockTextBrush}" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="ProgressTrack" TargetType="Border">
                <Setter Property="Height" Value="4" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            </Style>

            <Style x:Key="ProgressFill" TargetType="Border">
                <Setter Property="Height" Value="4" />
                <Setter Property="Width" Value="0" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4,2,4,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pomodoro -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14,10,14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Height="16" LastChildFill="True">
                    <StackPanel x:Name="SessionDots" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0" Background="Transparent" />
                    <TextBlock x:Name="SessionCountText" DockPanel.Dock="Right" Style="{StaticResource SmallText}" Margin="8,0,0,0"
                               Visibility="Collapsed" Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="PhaseGlyph" DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Margin="0,0,6,0"
                               Foreground="{StaticResource DockText2Brush}" Text="&#xE916;" />
                    <TextBlock x:Name="PhaseText" Style="{StaticResource HeaderText}" Text="Siap" />
                </DockPanel>

                <TextBlock x:Name="TimeText" Grid.Row="1" Style="{StaticResource BigNumber}" FontSize="32" LineHeight="36"
                           Margin="-1,4,0,0" Text="25:00" />

                <Grid x:Name="TimerTrack" Grid.Row="2" Margin="0,6,0,0">
                    <Border Style="{StaticResource ProgressTrack}" />
                    <Border x:Name="TimerFill" Style="{StaticResource ProgressFill}" Background="{StaticResource FocusBrush}" />
                </Grid>

                <TextBlock x:Name="TimerSubText" Grid.Row="3" Style="{StaticResource SmallText}" Margin="0,6,0,0"
                           Text="Fokus 25 mnt · rehat 5 mnt" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="StartPauseButton" Style="{StaticResource PillButton}" Width="Auto" MinWidth="84" Padding="14,0,16,0"
                            Background="{StaticResource FocusTintBrush}" Foreground="{StaticResource FocusBrush}"
                            Click="StartPause_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StartPauseGlyph" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" Text="&#xF5B0;" />
                            <TextBlock x:Name="StartPauseLabel" Margin="7,0,0,1" FontFamily="{StaticResource UiFont}" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Text="Mulai" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResetButton" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                            Content="&#xE777;" ToolTip="Ulang dari awal" AutomationProperties.Name="Ulang dari awal" Click="Reset_Click" />
                    <Button x:Name="SkipButton" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                            Content="&#xE893;" ToolTip="Lewati sesi ini" AutomationProperties.Name="Lewati sesi ini" Click="Skip_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Water -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14,10,14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Height="16" LastChildFill="True">
                    <TextBlock x:Name="GlassesText" DockPanel.Dock="Right" Style="{StaticResource SmallText}" Margin="8,0,0,0"
                               Typography.NumeralAlignment="Tabular" Text="0 gelas" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Margin="0,0,6,0"
                               Foreground="{StaticResource WaterBrush}" Text="&#xEB42;" />
                    <TextBlock Style="{StaticResource HeaderText}" Text="Minum" />
                </DockPanel>

                <TextBlock Grid.Row="1" Style="{StaticResource BigNumber}" Margin="-1,4,0,0" LineHeight="36">
                    <Run x:Name="WaterAmountRun" FontSize="26" Text="0" /><Run x:Name="WaterGoalRun" FontFamily="{StaticResource UiFont}"
                         FontSize="12" FontWeight="Normal" Foreground="{StaticResource DockText2Brush}" Text=" / 2.000 ml" />
                </TextBlock>

                <Grid x:Name="WaterTrack" Grid.Row="2" Margin="0,6,0,0">
                    <Border Style="{StaticResource ProgressTrack}" />
                    <Border x:Name="WaterFill" Style="{StaticResource ProgressFill}" Background="{StaticResource WaterBrush}" />
                </Grid>

                <TextBlock x:Name="WaterSubText" Grid.Row="3" Style="{StaticResource SmallText}" Margin="0,6,0,0"
                           Text="Kurang 2.000 ml lagi" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddGlassButton" Style="{StaticResource PillButton}" Width="Auto" Padding="14,0"
                            Background="{StaticResource WaterTintBrush}" Foreground="{StaticResource WaterTextBrush}"
                            FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold"
                            ToolTip="Catat segelas air" Click="AddGlass_Click">
                        <TextBlock x:Name="AddGlassText" Margin="0,0,0,1" Text="+1 gelas (250 ml)" />
                    </Button>
                    <Button x:Name="UndoButton" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                            Content="&#xE7A7;" ToolTip="Batalkan 1 gelas" AutomationProperties.Name="Batalkan 1 gelas" Click="UndoGlass_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
