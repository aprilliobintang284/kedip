<UserControl x:Class="Kedip.Views.Panels.MusicPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po"
             Height="150"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             RenderOptions.ClearTypeHint="Enabled"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource DockTextBrush}">
    <!-- Area: 440x150 DIP on black. 8-DIP grid; radii: art 10, pills/circles fully round. -->
    <UserControl.Resources>
        <StaticResource x:Key="LyricBrush" ResourceKey="InkF2" />
        <StaticResource x:Key="TertiaryBrush" ResourceKey="Ink66" />
        <StaticResource x:Key="QuaternaryBrush" ResourceKey="Ink47" />
        <StaticResource x:Key="TimeBrush" ResourceKey="Ink8C" />
        <StaticResource x:Key="TrackBrush" ResourceKey="Ink2E" />
        <StaticResource x:Key="FillBrush" ResourceKey="InkF2" />
        <StaticResource x:Key="HairlineBrush" ResourceKey="Ink17" />
        <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource DockTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Hover" Fill="{StaticResource InkFF}" Opacity="0" />
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0.1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.9" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.9" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0.16" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LyricLineStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Now playing -->
        <Grid x:Name="NowPlaying">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="6" />
                <RowDefinition Height="16" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Album art: placeholder, previous art (cross-fade source), current art, hairline edge. -->
            <Grid x:Name="ArtHost" Width="92" Height="92" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ArtScale" />
                </Grid.RenderTransform>
                <Border x:Name="ArtPlaceholder" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
                            <GradientStop Color="#FF2C2C2E" Offset="0" />
                            <GradientStop Color="#FF18181A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="32"
                               Foreground="{StaticResource QuaternaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="ArtBack" CornerRadius="10" />
                <Border x:Name="ArtFront" CornerRadius="10" />
                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource HairlineBrush}" IsHitTestVisible="False" />
            </Grid>

            <!-- Title, artist and lyrics. -->
            <Grid Grid.Column="2">
                <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock x:Name="ArtistText" FontSize="12" Foreground="{StaticResource DockText2Brush}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1,0,0"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                </StackPanel>

                <Grid x:Name="LyricsBox" VerticalAlignment="Bottom" Height="40" ClipToBounds="True">
                    <!-- Three slots; the first sits above the clip so a line can scroll out upwards. -->
                    <StackPanel x:Name="LyricStack" VerticalAlignment="Top" Margin="0,-20,0,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="LyricShift" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="LyricPrev" Style="{StaticResource LyricLineStyle}" Height="20" LineHeight="20"
                                   FontSize="13" Foreground="{StaticResource LyricBrush}" />
                        <TextBlock x:Name="LyricCurrent" Style="{StaticResource LyricLineStyle}" Height="20" LineHeight="20"
                                   FontSize="13" Foreground="{StaticResource LyricBrush}" />
                        <TextBlock x:Name="LyricNext" Style="{StaticResource LyricLineStyle}" Height="18" LineHeight="18"
                                   FontSize="12" Foreground="{StaticResource TertiaryBrush}" />
                    </StackPanel>

                    <!-- Shown instead of lyrics: searching / not available / album + source. -->
                    <StackPanel x:Name="LyricStatus" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed">
                        <TextBlock x:Name="StatusPrimary" FontSize="12" Foreground="{StaticResource TertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Name="StatusSecondary" FontSize="11" FontFamily="{StaticResource SmallFont}"
                                   Foreground="{StaticResource QuaternaryBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Progress: elapsed · bar · total. The bar is a 16-DIP hit area around a 4-DIP track. -->
            <Grid Grid.Row="2" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ElapsedText" MinWidth="30" FontSize="11" FontFamily="{StaticResource SmallFont}"
                           Foreground="{StaticResource TimeBrush}" Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center" TextAlignment="Left" Text="0:00" />
                <Grid x:Name="SeekArea" Grid.Column="1" Margin="8,0" Background="Transparent" Cursor="Hand">
                    <Border x:Name="SeekTrack" Height="4" CornerRadius="3" VerticalAlignment="Center"
                            Background="{StaticResource TrackBrush}" />
                    <Border x:Name="SeekFill" Height="4" CornerRadius="3" Width="0" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Background="{StaticResource FillBrush}" />
                    <Ellipse x:Name="SeekKnob" Width="10" Height="10" Fill="{StaticResource DockTextBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="KnobShift" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="TotalText" Grid.Column="2" MinWidth="30" FontSize="11" FontFamily="{StaticResource SmallFont}"
                           Foreground="{StaticResource TimeBrush}" Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center" TextAlignment="Right" Text="0:00" />
            </Grid>

            <!-- Transport. -->
            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Content="&#xF8AC;"
                        AutomationProperties.Name="Lagu sebelumnya" Click="OnPreviousClick" />
                <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Content="&#xF5B0;"
                        Width="36" Height="36" FontSize="18" Margin="16,0"
                        AutomationProperties.Name="Putar" Click="OnPlayPauseClick" />
                <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Content="&#xF8AD;"
                        AutomationProperties.Name="Lagu berikutnya" Click="OnNextClick" />
            </StackPanel>
        </Grid>

        <!-- Empty state. -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid Width="48" Height="48" HorizontalAlignment="Center">
                <Ellipse Fill="{StaticResource Ink1A}" />
                <TextBlock x:Name="EmptyGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{StaticResource DockText2Brush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="EmptyTitle" Text="Tidak ada musik yang diputar" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource LyricBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock x:Name="EmptyHint" Text="Putar lagu di Spotify, YouTube, atau aplikasi musik lain"
                       FontSize="12" Foreground="{StaticResource TertiaryBrush}" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
