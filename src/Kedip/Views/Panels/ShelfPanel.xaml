<UserControl x:Class="Kedip.Views.Panels.ShelfPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prod="clr-namespace:Kedip.Productivity"
             mc:Ignorable="d po"
             d:DesignWidth="440" d:DesignHeight="150"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource DockTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.ClearTypeHint="Enabled">
    <!-- Dropped files as horizontal tiles. Area: 440x150 DIP on black. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kedip;component/Productivity/PanelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BadgeBrush" Color="#FF3A3A3C" po:Freeze="True" />
            <SolidColorBrush x:Key="BadgeHoverBrush" Color="#FF5C5C60" po:Freeze="True" />
            <StaticResource x:Key="DropZoneBrush" ResourceKey="Ink33" />

            <!-- Small "x" badge in a tile's corner; black ring separates it from the icon. -->
            <Style x:Key="RemoveBadge" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource DockTextBrush}" />
                <Setter Property="Background" Value="{StaticResource BadgeBrush}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Badge" Background="{TemplateBinding Background}" BorderBrush="{StaticResource NotchBrush}"
                                    BorderThickness="1.5" CornerRadius="9">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="7" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextOptions.TextFormattingMode="Display" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource BadgeHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="TileTemplate" DataType="{x:Type prod:ShelfItem}">
                <Grid x:Name="Tile" Width="72" Height="96" Margin="0,0,4,0" Background="Transparent"
                      ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="900" ToolTipService.Placement="Bottom"
                      MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                      MouseMove="Tile_MouseMove"
                      MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                      LostMouseCapture="Tile_LostMouseCapture">
                    <Border x:Name="Hover" CornerRadius="12" Background="{StaticResource OverlayBrush}" Opacity="0" />
                    <StackPanel Margin="2,12,2,6">
                        <Grid Width="32" Height="32" HorizontalAlignment="Center">
                            <TextBlock x:Name="Placeholder" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{StaticResource DockText2Brush}" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="IconImage" Source="{Binding Icon, NotifyOnTargetUpdated=True}" Width="32" Height="32"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Image.Triggers>
                            </Image>
                        </Grid>
                        <TextBlock Text="{Binding Name}" Margin="0,8,0,0" FontFamily="{StaticResource SmallFont}" FontSize="11"
                                   Foreground="{StaticResource TextStrongBrush}" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   LineHeight="14" LineStackingStrategy="BlockLineHeight" MaxHeight="28"
                                   TextOptions.TextFormattingMode="Display" />
                    </StackPanel>
                    <Button x:Name="RemoveButton" Style="{StaticResource RemoveBadge}" Opacity="0" IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                            ToolTip="Hapus dari shelf" AutomationProperties.Name="Hapus dari shelf" Click="Remove_Click" />
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"
                                                     EasingFunction="{StaticResource EaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                        <Setter TargetName="Placeholder" Property="Text" Value="&#xE8B7;" />
                    </DataTrigger>
                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                        <Setter TargetName="RemoveButton" Property="IsHitTestVisible" Value="True" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                     To="0.08" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
                                    <DoubleAnimation Storyboard.TargetName="RemoveButton" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
                                    <DoubleAnimation Storyboard.TargetName="RemoveButton" Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,6,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Height="24" Margin="6,0,0,4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Margin="0,0,7,0"
                       Foreground="{StaticResource DockText2Brush}" Text="&#xE7B8;" />
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource HeaderText}" Text="Shelf" />
            <TextBlock x:Name="CountText" DockPanel.Dock="Left" Style="{StaticResource SmallText}" Margin="8,0,0,0"
                       Foreground="{StaticResource TextTertiaryBrush}" Typography.NumeralAlignment="Tabular" />
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Visibility="Collapsed"
                    ToolTip="Kosongkan shelf (file aslinya tidak dihapus)" Click="Clear_Click">
                <TextBlock Text="Bersihkan" />
            </Button>
        </DockPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PanningMode="HorizontalOnly" Focusable="False"
                      PreviewMouseWheel="Scroller_PreviewMouseWheel" ScrollChanged="Scroller_ScrollChanged">
            <ItemsControl x:Name="ItemsHost" ItemTemplate="{StaticResource TileTemplate}" Focusable="False"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <Grid x:Name="EmptyState" Grid.Row="1" Margin="0,0,0,2" Visibility="Collapsed">
            <Rectangle x:Name="DropZone" RadiusX="14" RadiusY="14" Stroke="{StaticResource DropZoneBrush}" StrokeThickness="1"
                       StrokeDashArray="5 4" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{StaticResource ControlFillBrush}">
                    <TextBlock Style="{StaticResource GlyphText}" FontSize="15" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextStrongBrush}" Text="&#xE896;" />
                </Border>
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="12" Foreground="{StaticResource TextStrongBrush}" TextOptions.TextFormattingMode="Display"
                           Text="Seret file ke notch untuk menyimpannya di sini" />
                <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" Style="{StaticResource SmallText}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="File aslinya tetap di tempat, tidak disalin" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
